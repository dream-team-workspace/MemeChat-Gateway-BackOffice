{
  "name": "memechat-backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MemeChat Gateway operator console",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist-server/server/src/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
