# Install on the server as /etc/memechat-backoffice.env
# Owner root:memechat, mode 0640. Never commit the real file.
NODE_ENV=production
APP_ENV=production
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=https://console.dream-team.works

# Reachable from the server; this must be the gateway admin API base URL.
ADMIN_API_BASE_URL=https://gateway.dream-team.works
# Must equal the gateway's 64-hex BACKOFFICE_API_KEY.
ADMIN_API_SECRET=CHANGE_ME

CF_ACCESS_TEAM_DOMAIN=rough-water-d6a6.cloudflareaccess.com
CF_ACCESS_AUD=CHANGE_ME
APP_VERSION=0.1.0
