# Browser-exposed value. Used only by `npm run dev` (import.meta.env.DEV).
# Production builds ignore it; Cloudflare Access is the production identity.
VITE_DEV_AUTH_EMAIL=operator@dream-team.works

# BFF (server-side). Never prefix these with VITE_.
APP_ENV=development
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
ADMIN_API_MODE=mock
# ADMIN_API_BASE_URL=http://127.0.0.1:8080
# ADMIN_API_SECRET=
CF_ACCESS_TEAM_DOMAIN=rough-water-d6a6.cloudflareaccess.com
# CF_ACCESS_AUD=
DEV_ACTOR_EMAIL=operator@dream-team.works
APP_VERSION=0.1.0
# APP_COMMIT=
